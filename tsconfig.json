{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "lib": ["ES2021"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "declaration": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    /* --- Path Mapping Changes Below --- */
    "baseUrl": "./",                       // Change from ./src to ./ so we can reach node_modules
    "paths": {
      "prisma-client": ["node_modules/prisma-client"], // Map your custom client
      "@/*": ["src/*"]                     // Adjusted to work with the new baseUrl
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"]
}