    "@anthropic-ai/sdk": "^0.39.0",
    "@prisma/client": "^5.7.0",
    "prisma": "^5.7.0",
    "axios": "^1.6.0",
    "bullmq": "^4.15.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
